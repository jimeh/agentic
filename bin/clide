#!/usr/bin/env bash

set -o pipefail

base_url="${CLIDE_BASE_URL:-${CLAUDEX_BASE_URL:-http://127.0.0.1:8317}}"
config="${CLIDE_CONFIG:-${CLAUDEX_CONFIG:-${CLIPROXYAPI_CONFIG:-$HOME/.cli-proxy-api/config.yaml}}}"
auth_token="${CLIDE_API_KEY:-${CLAUDEX_API_KEY:-${CLIPROXYAPI_API_KEY:-}}}"

if [[ -z "$auth_token" ]]; then
  if [[ ! -r "$config" ]]; then
    echo "clide: CLIProxyAPI config not readable: $config" >&2
    exit 1
  fi

  auth_token="$(awk '
    /^api-keys:/ { in_keys = 1; next }
    in_keys && /^[^[:space:]]/ { exit }
    in_keys && /^[[:space:]]*-/ {
      sub(/^[[:space:]]*-[[:space:]]*"?/, "")
      sub(/"?[[:space:]]*$/, "")
      print
      exit
    }
  ' "$config")"
fi

if [[ -z "$auth_token" ]]; then
  echo "clide: no API key found in $config" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="$base_url"
export ANTHROPIC_AUTH_TOKEN="$auth_token"

exec claude "$@"
