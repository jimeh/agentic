#!/usr/bin/env bash

set -o pipefail

model="${OPUS_MODEL:-claude-opus-5}"
effort="${OPUS_EFFORT:-medium}"
base_url="${OPUS_BASE_URL:-${CLAUDEX_BASE_URL:-http://127.0.0.1:8317}}"
config="${OPUS_CONFIG:-${CLAUDEX_CONFIG:-${CLIPROXYAPI_CONFIG:-$HOME/.cli-proxy-api/config.yaml}}}"
auth_token="${OPUS_API_KEY:-${CLAUDEX_API_KEY:-${CLIPROXYAPI_API_KEY:-}}}"

if [[ -z "$auth_token" ]]; then
  if [[ ! -r "$config" ]]; then
    echo "opus: CLIProxyAPI config not readable: $config" >&2
    exit 1
  fi

  auth_token="$(awk '
    /^api-keys:/ { in_keys = 1; next }
    in_keys && /^[^[:space:]]/ { exit }
    in_keys && /^[[:space:]]*-/ {
      sub(/^[[:space:]]*-[[:space:]]*"?/, "")
      sub(/"?[[:space:]]*$/, "")
      print
      exit
    }
  ' "$config")"
fi

if [[ -z "$auth_token" ]]; then
  echo "opus: no API key found in $config" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="$base_url"
export ANTHROPIC_AUTH_TOKEN="$auth_token"
export CLAUDE_CODE_SUBAGENT_MODEL="$model"
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1
export CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=3
export ENABLE_TOOL_SEARCH=false

effort_args=(--effort "$effort")
for arg in "$@"; do
  if [[ "$arg" == "--effort" || "$arg" == --effort=* ]]; then
    effort_args=()
    break
  fi
done

exec claude --model "$model" "${effort_args[@]}" "$@"
