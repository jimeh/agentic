{
  "description": "Rewrite Bash commands to run through the rtk token-optimizing proxy",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/rtk-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
